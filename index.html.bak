<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Suvana Construction LLC | Handyman & General Construction</title>

  <style>
    :root {
      --bg: #f3f4f6;
      --bg-alt: #ffffff;
      --primary: #1f2937;
      --primary-alt: #111827;
      --accent: #2563eb;
      --accent-soft: rgba(37,99,235,0.1);
      --muted: #6b7280;
      --border: #e5e7eb;
      --radius-card: 16px;
      --shadow-soft: 0 18px 45px rgba(15,23,42,0.12);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
        sans-serif;
    }

    body {
      background-color: var(--bg);
      color: var(--primary);
      line-height: 1.6;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    /* NAVBAR */
    header {
      position: sticky;
      top: 0;
      z-index: 40;
      background: rgba(17, 24, 39, 0.96);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(55,65,81,0.6);
    }

    .nav-bar {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0.8rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo-group {
      display: flex;
      align-items: center;
      gap: 0.7rem;
    }

    .logo-mark {
      width: 34px;
      height: 34px;
      border-radius: 10px;
      background: radial-gradient(circle at 20% 20%, #facc15, #f97316);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #0b1120;
      font-weight: 800;
      font-size: 0.9rem;
      box-shadow: 0 6px 16px rgba(0,0,0,0.35);
    }

    .logo-text {
      display: flex;
      flex-direction: column;
    }

    .logo-text span:first-child {
      color: #f9fafb;
      font-weight: 700;
      font-size: 0.95rem;
      letter-spacing: 0.08em;
    }

    .logo-text span:last-child {
      color: #9ca3af;
      font-size: 0.75rem;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      font-size: 0.9rem;
    }

    .nav-links a {
      color: #e5e7eb;
      opacity: 0.85;
    }

    .nav-links a:hover {
      opacity: 1;
    }

    .nav-cta {
      padding: 0.4rem 0.95rem;
      border-radius: 999px;
      background: #f97316;
      color: #111827;
      font-weight: 600;
      font-size: 0.82rem;
      box-shadow: 0 10px 20px rgba(249,115,22,0.4);
    }

    @media (max-width: 768px) {
      .nav-links {
        display: none;
      }
    }

    /* HERO */
    .hero {
      background: radial-gradient(circle at top left, #ffffff, #e5e7eb);
      border-bottom: 1px solid var(--border);
    }

    .hero-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem 3.2rem;
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: 2.2rem;
      align-items: center;
    }

    @media (max-width: 900px) {
      .hero-inner {
        grid-template-columns: 1fr;
      }
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.28rem 0.9rem;
      border-radius: 999px;
      background: var(--accent-soft);
      color: var(--accent);
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 0.8rem;
    }

    .hero-badge span {
      width: 7px;
      height: 7px;
      border-radius: 999px;
      background: #22c55e;
      box-shadow: 0 0 0 5px rgba(34,197,94,0.25);
    }

    .hero-title {
      font-size: 2.35rem;
      line-height: 1.15;
      margin-bottom: 0.7rem;
      color: var(--primary-alt);
    }

    .hero-title span {
      color: var(--accent);
    }

    .hero-subtitle {
      font-size: 0.98rem;
      color: var(--muted);
      margin-bottom: 1.4rem;
      max-width: 34rem;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.9rem;
      margin-bottom: 1.2rem;
    }

    .btn-primary {
      padding: 0.8rem 1.5rem;
      border-radius: 999px;
      border: none;
      cursor: pointer;
      background: var(--accent);
      color: #ffffff;
      font-size: 0.95rem;
      font-weight: 600;
      box-shadow: 0 15px 35px rgba(37,99,235,0.4);
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      text-decoration: none;
    }

    .btn-primary:hover {
      background: #1d4ed8;
    }

    .hero-meta {
      font-size: 0.9rem;
      color: var(--muted);
    }

    .hero-meta strong {
      color: var(--primary-alt);
    }

    .hero-card {
      background: #020617;
      color: #e5e7eb;
      border-radius: 24px;
      padding: 1.3rem 1.4rem;
      box-shadow: var(--shadow-soft);
      position: relative;
      overflow: hidden;
    }

    .hero-card::before {
      content: "";
      position: absolute;
      inset: -40%;
      background:
        radial-gradient(circle at 0% 0%, rgba(59,130,246,0.5), transparent 60%),
        radial-gradient(circle at 100% 100%, rgba(248,113,113,0.5), transparent 55%);
      opacity: 0.35;
      pointer-events: none;
    }

    .hero-card-inner {
      position: relative;
      z-index: 1;
    }

    .hero-card h2 {
      font-size: 1rem;
      margin-bottom: 0.6rem;
    }

    .hero-card p {
      font-size: 0.86rem;
      color: #9ca3af;
      margin-bottom: 0.75rem;
    }

    .hero-stats {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
      margin-top: 0.6rem;
    }

    .hero-stat {
      padding: 0.7rem 0.8rem;
      border-radius: 12px;
      background: rgba(15,23,42,0.85);
      border: 1px solid rgba(148,163,184,0.3);
    }

    .hero-stat strong {
      display: block;
      font-size: 1.1rem;
    }

    .hero-stat span {
      font-size: 0.76rem;
      color: #9ca3af;
    }

    /* MAIN */
    main {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2.8rem 1.5rem 3.5rem;
    }

    .section-header {
      text-align: center;
      margin-bottom: 2.2rem;
    }

    .section-kicker {
      display: inline-block;
      font-size: 0.78rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 0.25rem;
      font-weight: 600;
    }

    .section-header h2 {
      font-size: 1.7rem;
      margin-bottom: 0.4rem;
    }

    .section-header p {
      font-size: 0.94rem;
      color: var(--muted);
      max-width: 34rem;
      margin: 0 auto;
    }

    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.9rem;
    }

    .service-card {
      background: var(--bg-alt);
      border-radius: var(--radius-card);
      overflow: hidden;
      box-shadow: var(--shadow-soft);
      display: flex;
      flex-direction: column;
      transition: transform 0.18s ease, box-shadow 0.18s ease;
    }

    .service-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 24px 60px rgba(15,23,42,0.25);
    }

    .service-media {
      position: relative;
      overflow: hidden;
    }

    .service-media img {
      width: 100%;
      height: 210px;
      object-fit: cover;
      display: block;
      transform: scale(1.02);
      transition: transform 0.25s ease;
    }

    .service-card:hover .service-media img {
      transform: scale(1.06);
    }

    .service-tag {
      position: absolute;
      left: 14px;
      top: 14px;
      padding: 0.25rem 0.7rem;
      border-radius: 999px;
      background: rgba(15,23,42,0.84);
      color: #e5e7eb;
      font-size: 0.74rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .service-body {
      padding: 1.1rem 1.2rem 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      flex: 1;
    }

    .service-body h3 {
      font-size: 1.05rem;
      margin: 0;
    }

    .service-body p {
      font-size: 0.9rem;
      color: var(--muted);
    }

    .service-meta {
      font-size: 0.8rem;
      color: #9ca3af;
      margin-top: 0.4rem;
    }

    .cta-strip {
      margin-top: 3.2rem;
      padding: 1.6rem 1.8rem;
      border-radius: 20px;
      background: linear-gradient(120deg, #111827, #1f2937, #020617);
      color: #e5e7eb;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      box-shadow: var(--shadow-soft);
    }

    .cta-strip h3 {
      font-size: 1.2rem;
      margin-bottom: 0.25rem;
    }

    .cta-strip p {
      font-size: 0.9rem;
      color: #9ca3af;
    }

    .cta-strip .btn-primary {
      box-shadow: 0 18px 40px rgba(15,23,42,0.6);
    }

    .cta-strip small {
      display: block;
      margin-top: 0.3rem;
      font-size: 0.8rem;
      color: #9ca3af;
    }

    /* FORMS & NEW SECTIONS */
    .form-section {
      background: linear-gradient(135deg, #f3f4f6 0%, #ffffff 100%);
      border-radius: 20px;
      padding: 2rem 2rem;
      margin-bottom: 2.2rem;
      box-shadow: var(--shadow-soft);
    }

    .form-section h2 {
      font-size: 1.7rem;
      margin-bottom: 0.5rem;
      color: var(--primary-alt);
    }

    .form-section .section-subtitle {
      font-size: 0.94rem;
      color: var(--muted);
      margin-bottom: 1.8rem;
      max-width: 40rem;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.2rem;
      margin-bottom: 1.5rem;
    }

    .form-group {
      display: flex;
      flex-direction: column;
    }

    .form-group label {
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--primary-alt);
      margin-bottom: 0.5rem;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
      padding: 0.75rem 1rem;
      border: 1px solid var(--border);
      border-radius: 12px;
      font-family: inherit;
      font-size: 0.95rem;
      color: var(--primary);
      background: white;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-soft);
    }

    .form-group textarea {
      resize: vertical;
      min-height: 120px;
    }

    .form-full-width {
      grid-column: 1 / -1;
    }

    .btn-submit {
      padding: 0.9rem 2rem;
      border-radius: 999px;
      border: none;
      background: linear-gradient(135deg, var(--accent) 0%, #1d4ed8 100%);
      color: white;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 15px 35px rgba(37,99,235,0.4);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .btn-submit:hover {
      transform: translateY(-2px);
      box-shadow: 0 20px 40px rgba(37,99,235,0.5);
    }

    .btn-submit:active {
      transform: translateY(0);
    }

    /* TESTIMONIALS */
    .testimonials-section {
      margin-bottom: 2.2rem;
    }

    .testimonials-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.9rem;
    }

    .testimonial-card {
      background: var(--bg-alt);
      padding: 1.5rem 1.6rem;
      border-radius: var(--radius-card);
      box-shadow: var(--shadow-soft);
      border-left: 4px solid var(--accent);
      transition: transform 0.18s ease, box-shadow 0.18s ease;
    }

    .testimonial-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 24px 60px rgba(15,23,42,0.15);
    }

    .testimonial-quote {
      font-size: 0.95rem;
      font-style: italic;
      color: var(--primary);
      margin-bottom: 1rem;
      line-height: 1.7;
    }

    .testimonial-author {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.5rem;
    }

    .testimonial-avatar {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--accent), #f97316);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: 700;
      font-size: 1.1rem;
    }

    .testimonial-info h4 {
      margin: 0;
      font-size: 0.95rem;
      color: var(--primary-alt);
    }

    .testimonial-service {
      font-size: 0.85rem;
      color: var(--muted);
    }

    .testimonial-rating {
      display: flex;
      gap: 0.25rem;
      margin-top: 0.5rem;
    }

    .star {
      color: #facc15;
      font-size: 1.1rem;
    }

    /* CONTACT FORM SECTION */
    #contact-form {
      background: linear-gradient(120deg, #111827, #1f2937, #020617);
      color: #e5e7eb;
      border-radius: 20px;
      padding: 2rem 2rem;
      margin-bottom: 2.2rem;
    }

    #contact-form h2 {
      font-size: 1.7rem;
      color: #f9fafb;
      margin-bottom: 0.5rem;
    }

    #contact-form .section-subtitle {
      color: #9ca3af;
    }

    #contact-form .form-group label {
      color: #e5e7eb;
    }

    #contact-form .form-group input,
    #contact-form .form-group select,
    #contact-form .form-group textarea {
      background: rgba(255,255,255,0.95);
      color: var(--primary);
    }

    .contact-info-strip {
      display: flex;
      flex-wrap: wrap;
      gap: 2rem;
      margin-top: 1.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid rgba(255,255,255,0.2);
    }

    .contact-info-item {
      flex: 1;
      min-width: 200px;
    }

    .contact-info-item strong {
      color: #f9fafb;
      display: block;
      margin-bottom: 0.3rem;
      font-size: 0.9rem;
    }

    .contact-info-item span {
      color: #93c5fd;
      font-size: 1rem;
    }

    .contact-info-item span a {
      color: #93c5fd;
    }

    /* FOOTER */
    footer {
      background: #020617;
      color: #9ca3af;
      text-align: center;
      padding: 1.6rem 1rem 2rem;
      font-size: 0.85rem;
      border-top: 1px solid #111827;
    }

    footer a {
      color: #93c5fd;
    }

    footer a:hover {
      text-decoration: underline;
    }
  </style>
</head>

<body>

<header>
  <div class="nav-bar">
    <div class="logo-group">
      <div class="logo-mark">SC</div>
      <div class="logo-text">
        <span>SUVANA CONSTRUCTION LLC</span>
        <span>Middletown, Delaware • Handyman &amp; General Construction</span>
      </div>
    </div>
    <nav class="nav-links">
      <a href="#services">Services</a>
      <a href="#quote-request">Get Quote</a>
      <a href="#testimonials">Reviews</a>
      <a href="#contact-form" class="nav-cta">Contact</a>
    </nav>
  </div>
</header>

<section class="hero">
  <div class="hero-inner">
    <div>
      <div class="hero-badge">
        <span></span>
       <h2> Fully licensed and Insured • Trusted Local Contractor </h2>
      </div>
      <h1 class="hero-title">
        Professional services for your home.
      </h1>
      <p class="hero-subtitle">
        Suvana Construction LLC delivers safe, dependable construction and repair
        work for kitchens, basements, flooring, and more &mdash; with clear
        communication from first visit to final walk-through.
      </p>

      <div class="hero-actions">
        <a href="#contact" class="btn-primary">
          Request a free estimate
          <span>→</span>
        </a>
        <div class="hero-meta">
          <strong>Phone:</strong> 302-844-8097<br />
          <strong>Email:</strong> contactsuvana@gmail.com
        </div>
      </div>
      <div class="hero-meta">
      </div>
    </div>

<aside class="hero-card">
  <div class="hero-card-inner">

    <h2>One team for all your projects</h2>
    <p>
      From quick fixes to full room remodels, we coordinate every trade so you
      only have to call one company.
    </p>

    <div class="hero-stats">
      <div class="hero-stat">
        <strong>10+</strong>
        <span>core handyman &amp; construction services</span>
      </div>
      <div class="hero-stat">
        <strong>Single</strong>
        <span>point of contact for your entire project</span>
      </div>
    </div>

  </div>
</aside>
  </div>
</section>

<main>
  <section id="services">
    <div class="section-header">
      <div class="section-kicker">Our Services</div>
      <h2>Remodeling &amp; handyman solutions</h2>
      <p>
        Suvana Construction LLC offers a full range of residential services so you
        can handle your remodels, upgrades, and small repairs with one trusted crew.
      </p>
    </div>

    <div class="services-grid">

      <!-- Kitchen Remodel -->
      <article class="service-card">
        <div class="service-media">
          <img src="kitchen_remodeling.png" alt="Handyman installing countertops in a modern white kitchen" />
          <span class="service-tag">Kitchen Remodel</span>
        </div>
        <div class="service-body">
          <h3>Modern, functional kitchens</h3>
          <p>
            Layout improvements, new cabinets, countertops, lighting, and backsplashes
            tailored to how your family actually uses the space.
          </p>
          <div class="service-meta">Design support • demo • installation • finishes</div>
        </div>
      </article>

      <!-- Drywall Installation -->
      <article class="service-card">
        <div class="service-media">
          <img src="drywall.png" alt="Worker installing drywall sheet on framed interior wall" />
          <span class="service-tag">Drywall</span>
        </div>
        <div class="service-body">
          <h3>New walls &amp; smooth repairs</h3>
          <p>
            Professional hanging, taping, and finishing for additions, basements, and
            damaged areas so your walls are perfectly paint-ready.
          </p>
          <div class="service-meta">Hanging • taping • skim coating • patch repair</div>
        </div>
      </article>

      <!-- Plumbing Work -->
      <article class="service-card">
        <div class="service-media">
          <img src="plumbing.png" alt="Handyman tightening plumbing fittings under a kitchen sink" />
          <span class="service-tag">Plumbing</span>
        </div>
        <div class="service-body">
          <h3>Everyday plumbing projects</h3>
          <p>
            Fixture installs, supply and drain line work, and minor leak repairs to
            keep kitchens, baths, and laundry spaces running smoothly.
          </p>
          <div class="service-meta">Faucets • disposals • traps • minor repairs</div>
        </div>
      </article>

      <!-- Electrical Work -->
      <article class="service-card">
        <div class="service-media">
          <img src="electrical.png" alt="Electrician testing wiring while installing a new outlet" />
          <span class="service-tag">Electrical</span>
        </div>
        <div class="service-body">
          <h3>Safe, code-conscious upgrades</h3>
          <p>
            Swap lights and fans, add outlets and dimmers, and complete small
            electrical projects with safety and code compliance in mind.
          </p>
          <div class="service-meta">Lights • fans • outlets • switches</div>
        </div>
      </article>

      <!-- Hardwood / Vinyl Flooring -->
      <article class="service-card">
        <div class="service-media">
          <img src="flooring.png" alt="Close-up of hands installing plank flooring" />
          <span class="service-tag">Flooring</span>
        </div>
        <div class="service-body">
          <h3>Hardwood &amp; vinyl plank</h3>
          <p>
            Durable, easy-care flooring installed with clean transitions and tight
            seams for high-traffic rooms and whole-home updates.
          </p>
          <div class="service-meta">Subfloor prep • install • trim • transitions</div>
        </div>
      </article>

      <!-- Fireplace & TV Wall Feature -->
      <article class="service-card">
        <div class="service-media">
          <img src="fireplace_TV.png" alt="Custom feature wall with TV and electric fireplace" />
          <span class="service-tag">Fireplace &amp; TV Wall</span>
        </div>
        <div class="service-body">
          <h3>Custom living room focal points</h3>
          <p>
            Build a clean feature wall with TV mounting, recessed electric fireplace,
            and wood or built-in shelving to anchor your living space.
          </p>
          <div class="service-meta">Framing • wiring coordination • finishes</div>
        </div>
      </article>

      <!-- Finish Basement -->
      <article class="service-card">
        <div class="service-media">
          <img src="finish_basement.png" alt="Finished basement with handyman doing touch ups" />
          <span class="service-tag">Basement Finish</span>
        </div>
        <div class="service-body">
          <h3>Turn unused space into living area</h3>
          <p>
            Complete basement build-outs including framing, insulation, drywall,
            flooring, and trim to create family rooms, offices, or guest suites.
          </p>
          <div class="service-meta">Planning • framing • electrical • finishes</div>
        </div>
      </article>

      <!-- Painting -->
      <article class="service-card">
        <div class="service-media">
          <img src="painting.png" alt="Painter rolling fresh white paint on an interior wall" />
          <span class="service-tag">Painting</span>
        </div>
        <div class="service-body">
          <h3>Crisp, professional paint work</h3>
          <p>
            Interior painting with thorough prep, caulking, and sharp lines for
            accent walls, single rooms, or whole-home refreshes.
          </p>
          <div class="service-meta">Walls • ceilings • trim • doors</div>
        </div>
      </article>

      <!-- Remodeling -->
      <article class="service-card">
        <div class="service-media">
          <img src="remodeling.png" alt="Handyman framing a new interior wall during remodel" />
          <span class="service-tag">Remodeling</span>
        </div>
        <div class="service-body">
          <h3>Room-by-room remodeling</h3>
          <p>
            Interior updates including wall changes, new openings, trim carpentry,
            and finish upgrades that align with your budget and timeline.
          </p>
          <div class="service-meta">Planning • framing • finishes • punch-list</div>
        </div>
      </article>

      <!-- Full Handyman Service Scenes -->
      <article class="service-card">
        <div class="service-media">
          <img src="full_handiman services.png" alt="Collage of handyman performing various home repairs" />
          <span class="service-tag">Handyman Services</span>
        </div>
        <div class="service-body">
          <h3>Small jobs &amp; ongoing maintenance</h3>
          <p>
            Tackle your to-do list in a single visit: doors that stick, trim repairs,
            minor plumbing and electrical, TV mounting, caulking, and more.
          </p>
          <div class="service-meta">Hourly • half-day • full-day service options</div>
        </div>
      </article>

    </div>
  </section>

  <!-- QUOTE REQUEST FORM -->
  <section id="quote-request" class="form-section">
    <h2>Request a Free Quote</h2>
    <p class="section-subtitle">
      Share details about your project, and we'll provide a competitive estimate tailored to your needs.
    </p>
    <form action="https://formspree.io/f/YOUR_FORM_ID_HERE" method="POST">
      <div class="form-grid">
        <div class="form-group">
          <label for="quote-name">Your Name *</label>
          <input type="text" id="quote-name" name="name" required>
        </div>
        <div class="form-group">
          <label for="quote-email">Email *</label>
          <input type="email" id="quote-email" name="email" required>
        </div>
        <div class="form-group">
          <label for="quote-phone">Phone *</label>
          <input type="tel" id="quote-phone" name="phone" required>
        </div>
        <div class="form-group">
          <label for="quote-service">Service Type *</label>
          <select id="quote-service" name="service" required>
            <option value="">Select a service...</option>
            <option value="Kitchen Remodel">Kitchen Remodel</option>
            <option value="Drywall">Drywall</option>
            <option value="Plumbing">Plumbing</option>
            <option value="Electrical">Electrical</option>
            <option value="Flooring">Flooring</option>
            <option value="Fireplace & TV Wall">Fireplace & TV Wall</option>
            <option value="Basement Finish">Basement Finish</option>
            <option value="Painting">Painting</option>
            <option value="Remodeling">Remodeling</option>
            <option value="Handyman Services">Handyman Services</option>
          </select>
        </div>
        <div class="form-group form-full-width">
          <label for="quote-description">Project Description *</label>
          <textarea id="quote-description" name="project_details" required placeholder="Tell us about your project..."></textarea>
        </div>
        <div class="form-group">
          <label for="quote-timeline">Timeline</label>
          <select id="quote-timeline" name="timeline">
            <option value="">Select timeline...</option>
            <option value="ASAP">As soon as possible</option>
            <option value="Within 2 weeks">Within 2 weeks</option>
            <option value="Within 1 month">Within 1 month</option>
            <option value="Flexible">Flexible</option>
          </select>
        </div>
        <div class="form-group">
          <label for="quote-budget">Budget Range</label>
          <select id="quote-budget" name="budget">
            <option value="">Select range...</option>
            <option value="Under $1,000">Under $1,000</option>
            <option value="$1,000 - $5,000">$1,000 - $5,000</option>
            <option value="$5,000 - $10,000">$5,000 - $10,000</option>
            <option value="$10,000+">$10,000+</option>
          </select>
        </div>
      </div>
      <button type="submit" class="btn-submit">Get My Free Quote</button>
      <p style="font-size: 0.8rem; color: var(--muted); margin-top: 0.8rem;">
        We'll review your details and reach out within 24 hours.
      </p>
    </form>
  </section>

